<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>cowsay</AssemblyName>
    <RootNamespace>Cowsay.Cli</RootNamespace>
    <ApplicationIcon>cow-face_1f42e.ico</ApplicationIcon>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cowsay</ToolCommandName>
    <PackageId>cowsay-dotnet</PackageId>
    <Title>Cowsay .NET</Title>
    <Description>A modern .NET reimplementation of the classic Unix cowsay utility.</Description>
    <PackageTags>cowsay;cli;ascii-art;terminal</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="cow-face_1f42e.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cowsay.Application\Cowsay.Application.csproj" />
    <ProjectReference Include="..\Cowsay.Infrastructure\Cowsay.Infrastructure.csproj" />
    <ProjectReference Include="..\CowSay.Core\CowSay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="assets\cows\**\*.cow">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
