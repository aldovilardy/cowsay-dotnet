<?xml version="1.0" encoding="UTF-8"?>

<!--
  WiX v4 installer definition for cowsay-dotnet.
  
  Build with: wix build cowsay-dotnet.wxs -o cowsay-dotnet.msi
  
  The build-installer.ps1 script handles variable substitution and
  per-RID builds automatically.
-->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- Variables set by build-installer.ps1 -->
  <?define ProductVersion = "1.0.0" ?>
  <?define ProductName = "cowsay-dotnet" ?>
  <?define Manufacturer = "cowsay-dotnet contributors" ?>
  <?define UpgradeCode = "7E3F8A2B-1C4D-4E5F-9A6B-8C7D0E1F2A3B" ?>

  <Package
    Name="$(var.ProductName)"
    Version="$(var.ProductVersion)"
    Manufacturer="$(var.Manufacturer)"
    UpgradeCode="$(var.UpgradeCode)"
    Compressed="yes"
    InstallerVersion="500">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Installation directory structure -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="cowsay-dotnet">
        <Directory Id="COWSFOLDER" Name="cows" />
      </Directory>
    </StandardDirectory>

    <!-- Main components -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- cowsay.exe -->
      <Component Id="CowsayExe" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
        <File Id="cowsay.exe" Source="!(bindpath.BinDir)\cowsay.exe" KeyPath="yes" />
      </Component>

      <!-- cowthink.exe -->
      <Component Id="CowthinkExe" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
        <File Id="cowthink.exe" Source="!(bindpath.BinDir)\cowthink.exe" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <!-- Cow art files: defined in cowfiles.wxs (generated by build-installer.ps1) -->

    <!-- Add install directory to PATH -->
    <Component Id="PathEntry" Directory="INSTALLFOLDER" Guid="C3D4E5F6-A7B8-9012-CDEF-123456789012">
      <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
    </Component>

    <!-- Feature definition -->
    <Feature Id="ProductFeature" Title="cowsay-dotnet" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="CowFiles" />
      <ComponentRef Id="PathEntry" />
    </Feature>

  </Package>

</Wix>
